# Telegram Bot API delivery. Keep real values only in local/production secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local/manual lead delivery mode. Production must use LEAD_DELIVERY_MODE=telegram.
LEAD_DELIVERY_MODE=
MOCK_LEAD_RESULT=

# Cloudflare Turnstile keys. The site key may be public; the secret key must stay server-side.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
