---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  theme?: "light" | "dark";
  align?: "left" | "center";
  id?: string;
}

const {
  eyebrow,
  title,
  description,
  theme = "light",
  align = "left",
  id,
} = Astro.props as Props;

const isDark = theme === "dark";
const alignment = align === "center" ? "mx-auto text-center" : "";
const textColor = isDark ? "text-white" : "text-[rgb(var(--color-text))]";
const descriptionColor = isDark
  ? "text-white/68"
  : "text-[rgb(var(--color-muted))]";
---

<div class={`max-w-3xl ${alignment}`}>
  {
    eyebrow && (
      <div
        class={`mb-5 flex items-center gap-4 ${align === "center" ? "justify-center" : ""}`}
      >
        <span
          aria-hidden="true"
          class="h-px w-12 bg-[rgb(var(--color-accent))]"
        />
        <p class="text-sm font-bold uppercase tracking-[0.12em] text-[rgb(var(--color-accent))]">
          {eyebrow}
        </p>
      </div>
    )
  }
  <h2
    class={`text-[clamp(2rem,3.4vw,3.6rem)] font-black uppercase leading-[1.02] ${textColor}`}
    id={id}
  >
    {title}
  </h2>
  {
    description && (
      <p class={`mt-5 text-base leading-8 sm:text-lg ${descriptionColor}`}>
        {description}
      </p>
    )
  }
</div>
