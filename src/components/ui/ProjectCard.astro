---
import ImagePlaceholder from "./ImagePlaceholder.astro";

export interface Props {
  title: string;
  category: string;
  imageAspectRatio: string;
  imageLabel: string;
  featured?: boolean;
  placeholderClassName?: string;
}

const {
  title,
  category,
  imageAspectRatio,
  imageLabel,
  featured = false,
  placeholderClassName = "",
} = Astro.props as Props;
---

<article
  class={`group flex h-full min-w-0 flex-col overflow-hidden rounded-[var(--radius-md)] border border-[rgb(var(--color-border))] bg-[rgb(var(--color-surface))] shadow-[var(--shadow-soft)] ${
    featured ? "md:col-span-2 lg:col-span-6 lg:row-span-2" : "lg:col-span-3"
  }`}
  data-project-card
>
  <ImagePlaceholder
    decorative
    ratio={imageAspectRatio}
    label={imageLabel}
    className={`shrink-0 rounded-none border-0 ${placeholderClassName}`}
  />
  <div
    class={`flex min-w-0 flex-1 flex-col justify-between gap-5 p-5 ${
      featured ? "sm:p-6" : ""
    }`}
  >
    <div class="min-w-0">
      <p
        class="text-xs font-bold uppercase tracking-[0.14em] text-[rgb(var(--color-accent-strong))]"
      >
        {category}
      </p>
      <h3
        class={`mt-3 break-words font-black uppercase leading-tight text-[rgb(var(--color-text))] [overflow-wrap:anywhere] ${
          featured ? "text-2xl sm:text-3xl" : "text-xl"
        }`}
      >
        {title}
      </h3>
    </div>
    <p class="text-sm leading-6 text-[rgb(var(--color-muted))]">
      Фото и детали проекта будут заменены после передачи реальных материалов.
    </p>
  </div>
</article>
