---
import type { ImageMetadata } from "astro";
import ResponsiveImage from "./ResponsiveImage.astro";

export interface Props {
  title: string;
  category: string;
  image: ImageMetadata;
  alt: string;
}

const { title, category, image, alt } = Astro.props as Props;
---

<article
  class="group flex h-full min-w-0 flex-col overflow-hidden rounded-[var(--radius-md)] border border-[rgb(var(--color-border))] bg-[rgb(var(--color-surface))] shadow-[var(--shadow-soft)]"
  data-project-card
>
  <ResponsiveImage
    alt={alt}
    className="project-card__image"
    desktop={image}
    desktopSizes="(min-width: 1280px) calc((min(100vw - 5rem, 1500px) - 5rem) / 5), (min-width: 768px) calc((100vw - 5.25rem) / 2), calc(100vw - 2rem)"
  />
  <div class="flex min-w-0 flex-1 flex-col justify-between gap-4 p-5">
    <div class="min-w-0">
      <p
        class="text-xs font-bold uppercase tracking-[0.14em] text-[rgb(var(--color-accent-strong))]"
      >
        {category}
      </p>
      <h3
        class="mt-3 break-words text-xl font-black uppercase leading-tight text-[rgb(var(--color-text))] [overflow-wrap:anywhere]"
      >
        {title}
      </h3>
    </div>
  </div>
</article>

<style>
  .project-card__image {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: rgb(var(--color-surface-dark));
  }

  .project-card__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
