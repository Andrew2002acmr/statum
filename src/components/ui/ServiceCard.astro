---
import { PanelsTopLeft, Sofa, Wrench } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import ResponsiveImage from "./ResponsiveImage.astro";

export interface Props {
  title: string;
  description: string;
  image: {
    desktop: ImageMetadata;
    mobile: ImageMetadata;
  };
  alt: string;
  icon: "Sofa" | "PanelsTopLeft" | "Wrench";
}

const { title, description, image, alt, icon } = Astro.props as Props;

const icons = {
  Sofa,
  PanelsTopLeft,
  Wrench,
};

const Icon = icons[icon];
---

<article
  class="flex h-full min-w-0 flex-col overflow-hidden rounded-[var(--radius-md)] border border-[rgb(var(--color-border))] bg-[rgb(var(--color-surface))] shadow-[var(--shadow-soft)]"
  data-service-card
>
  <ResponsiveImage
    alt={alt}
    className="service-card__image"
    desktop={image.desktop}
    desktopSizes="(min-width: 1280px) calc((min(100vw - 5rem, 1500px) - 2.5rem) / 3), (min-width: 768px) calc((100vw - 5.25rem) / 2), calc(100vw - 2rem)"
    mobile={image.mobile}
    mobileSizes="calc(100vw - 2rem)"
  />
  <div class="flex min-w-0 flex-1 flex-col gap-4 p-5">
    <div
      class="grid h-11 w-11 shrink-0 place-items-center rounded-[var(--radius-sm)] border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg))] text-[rgb(var(--color-text))]"
      title={alt}
    >
      <Icon aria-hidden="true" size={23} stroke-width={1.9} />
    </div>
    <div class="min-w-0">
      <h3
        class="break-words text-lg font-black leading-tight text-[rgb(var(--color-text))] [overflow-wrap:anywhere]"
        data-service-card-title
      >
        {title}
      </h3>
      <p
        class="mt-3 break-words text-sm leading-[1.7] text-[rgb(var(--color-muted))] [overflow-wrap:anywhere]"
        data-service-card-description
      >
        {description}
      </p>
    </div>
  </div>
</article>

<style>
  .service-card__image {
    display: block;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: rgb(var(--color-surface-dark));
  }

  .service-card__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 639px) {
    .service-card__image {
      aspect-ratio: 4 / 5;
    }
  }
</style>
