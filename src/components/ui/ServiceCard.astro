---
import { House, PaintRoller, PanelsTopLeft, Sofa, Wrench } from "@lucide/astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";

export interface Props {
  title: string;
  description: string;
  imageAspectRatio: string;
  imageLabel: string;
  icon: "Sofa" | "House" | "PaintRoller" | "PanelsTopLeft" | "Wrench";
}

const { title, description, imageAspectRatio, imageLabel, icon } =
  Astro.props as Props;

const icons = {
  Sofa,
  House,
  PaintRoller,
  PanelsTopLeft,
  Wrench,
};

const Icon = icons[icon];
---

<article
  class="grid overflow-hidden rounded-[var(--radius-md)] border border-[rgb(var(--color-border))] bg-[rgb(var(--color-surface))] shadow-[var(--shadow-soft)]"
  data-service-card
>
  <ImagePlaceholder
    decorative
    ratio={imageAspectRatio}
    className="rounded-none border-0 bg-[linear-gradient(135deg,rgb(17_19_21_/_0.08),rgb(255_255_255_/_0.78)_45%,rgb(var(--color-accent)_/_0.13))]"
  />
  <div class="grid gap-4 p-5">
    <div
      class="grid h-12 w-12 place-items-center rounded-[var(--radius-sm)] border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg))] text-[rgb(var(--color-text))]"
      title={imageLabel}
    >
      <Icon aria-hidden="true" size={25} stroke-width={1.9} />
    </div>
    <div>
      <h3
        class="text-xl font-black leading-tight text-[rgb(var(--color-text))]"
      >
        {title}
      </h3>
      <p class="mt-3 text-sm leading-6 text-[rgb(var(--color-muted))]">
        {description}
      </p>
    </div>
  </div>
</article>
