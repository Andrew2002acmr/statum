---
import {
  BadgeCheck,
  ClipboardCheck,
  ListChecks,
  MessagesSquare,
  ShieldCheck,
} from "@lucide/astro";

export interface Props {
  title: string;
  description: string;
  icon:
    | "ListChecks"
    | "MessagesSquare"
    | "ClipboardCheck"
    | "BadgeCheck"
    | "ShieldCheck";
}

const { title, description, icon } = Astro.props as Props;

const icons = {
  ListChecks,
  MessagesSquare,
  ClipboardCheck,
  BadgeCheck,
  ShieldCheck,
};

const Icon = icons[icon];
---

<article
  class="grid gap-5 border-l border-white/12 px-6 py-6 first:border-l-0"
  data-benefit-card
>
  <div
    class="grid h-12 w-12 place-items-center rounded-[var(--radius-sm)] border border-[rgb(var(--color-accent)_/_0.45)] text-[rgb(var(--color-accent))]"
  >
    <Icon aria-hidden="true" size={24} stroke-width={1.9} />
  </div>
  <div>
    <h3 class="text-lg font-black uppercase leading-tight text-white">
      {title}
    </h3>
    <p class="mt-3 text-sm leading-6 text-white/68">{description}</p>
  </div>
</article>
