---
import { ArrowRight, CircleCheck } from "@lucide/astro";
import { site } from "../../data/site";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import ImagePlaceholder from "../ui/ImagePlaceholder.astro";
---

<section
  class="overflow-hidden bg-[rgb(var(--color-surface-dark))] text-white"
  id="hero"
  aria-labelledby="hero-title"
>
  <Container>
    <div
      class="grid gap-10 py-[var(--section-space-md)] lg:min-h-[620px] lg:grid-cols-[minmax(0,1fr)_minmax(360px,0.88fr)] lg:items-center lg:gap-12"
    >
      <div class="max-w-3xl">
        <p
          class="mb-5 inline-flex rounded-full border border-white/12 px-4 py-2 text-sm font-semibold uppercase tracking-[0.08em] text-[rgb(var(--color-accent))]"
        >
          {site.hero.eyebrow}
        </p>
        <h1
          class="max-w-3xl text-4xl font-black uppercase leading-[1.1] text-white sm:text-5xl lg:text-6xl lg:leading-[1.06]"
          id="hero-title"
        >
          {site.hero.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/72">
          {site.hero.description}
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="#lead-request" className="w-full sm:w-auto">
            <span class="inline-flex items-center gap-2">
              {site.primaryCta}
              <ArrowRight aria-hidden="true" size={18} />
            </span>
          </Button>
          <Button
            href="#projects"
            variant="secondary"
            className="w-full border-white/22 bg-transparent text-white hover:bg-white/6 sm:w-auto"
          >
            {site.secondaryCta}
          </Button>
        </div>

        <ul
          class="mt-8 grid gap-3 text-sm text-white/72 sm:grid-cols-3"
          aria-label="Рабочие принципы"
        >
          <li class="flex gap-2">
            <CircleCheck
              aria-hidden="true"
              class="mt-0.5 text-[rgb(var(--color-accent))]"
              size={18}
            />
            <span>Без неподтверждённых обещаний</span>
          </li>
          <li class="flex gap-2">
            <CircleCheck
              aria-hidden="true"
              class="mt-0.5 text-[rgb(var(--color-accent))]"
              size={18}
            />
            <span>Понятная коммуникация</span>
          </li>
          <li class="flex gap-2">
            <CircleCheck
              aria-hidden="true"
              class="mt-0.5 text-[rgb(var(--color-accent))]"
              size={18}
            />
            <span>Акцент на контроле этапов</span>
          </li>
        </ul>
      </div>

      <div class="grid gap-5">
        <div
          class="relative overflow-hidden rounded-[var(--radius-lg)] border border-white/12 bg-white/5 p-3 shadow-[var(--shadow-strong)]"
        >
          <ImagePlaceholder
            decorative
            ratio="16 / 10"
            className="border-white/10 bg-[linear-gradient(135deg,rgb(255_255_255_/_0.12),rgb(255_255_255_/_0.03))]"
          />
          <div
            class="pointer-events-none absolute inset-3 rounded-[var(--radius-md)] ring-1 ring-inset ring-white/8"
          >
          </div>
        </div>

        <aside
          aria-labelledby="lead-request-title"
          class="rounded-[var(--radius-md)] border border-white/12 bg-white p-5 text-[rgb(var(--color-text))] shadow-[var(--shadow-soft)]"
          id="lead-request"
        >
          <p
            class="text-sm font-semibold uppercase tracking-[0.08em] text-[rgb(var(--color-accent-strong))]"
          >
            Временная форма
          </p>
          <h2
            class="mt-2 text-xl font-black uppercase leading-tight"
            id="lead-request-title"
          >
            {site.hero.formTitle}
          </h2>
          <p class="mt-3 text-sm leading-6 text-[rgb(var(--color-muted))]">
            {site.hero.formDescription}
          </p>
          <div class="mt-5 grid gap-3" aria-hidden="true">
            <div
              class="h-11 rounded-[var(--radius-sm)] border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg))]"
            >
            </div>
            <div
              class="h-11 rounded-[var(--radius-sm)] border border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg))]"
            >
            </div>
            <div
              class="h-11 rounded-[var(--radius-sm)] bg-[rgb(var(--color-accent))]"
            >
            </div>
          </div>
        </aside>
      </div>
    </div>
  </Container>
</section>
