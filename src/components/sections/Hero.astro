---
import { ArrowRight, CircleCheck } from "@lucide/astro";
import { site } from "../../data/site";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import ImagePlaceholder from "../ui/ImagePlaceholder.astro";
---

<section
  class="overflow-hidden border-b border-white/10 bg-[rgb(var(--color-surface-dark))] text-white"
  id="hero"
  aria-labelledby="hero-title"
>
  <Container>
    <div
      class="grid gap-12 py-12 lg:py-14 xl:min-h-[660px] xl:grid-cols-[minmax(0,0.98fr)_minmax(520px,0.88fr)] xl:items-center xl:gap-16"
    >
      <div class="max-w-[820px]">
        <div
          class="mb-7 flex items-center gap-4 text-[0.82rem] font-bold uppercase tracking-[0.12em] text-[rgb(var(--color-accent))]"
        >
          <span
            aria-hidden="true"
            class="h-px w-12 bg-[rgb(var(--color-accent))]"></span>
          <p>{site.hero.eyebrow}</p>
        </div>
        <h1
          class="max-w-[820px] text-[clamp(2.55rem,4.6vw,5.15rem)] font-black uppercase leading-[1.04] text-white xl:leading-[0.99]"
          id="hero-title"
        >
          {site.hero.title}
          <span class="mt-2 block text-[rgb(var(--color-accent))]"
            >{site.hero.titleAccent}</span
          >
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/72">
          {site.hero.description}
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="#lead-request" className="w-full sm:w-auto">
            <span class="inline-flex items-center gap-2">
              {site.primaryCta}
              <ArrowRight aria-hidden="true" size={18} />
            </span>
          </Button>
          <Button
            href="#projects"
            variant="secondary"
            className="w-full border-white/22 bg-transparent text-white hover:bg-white/6 sm:w-auto"
          >
            {site.secondaryCta}
          </Button>
        </div>

        <ul
          class="mt-8 grid gap-3 text-sm text-white/72 md:grid-cols-3 xl:max-w-[760px]"
          aria-label="Рабочие принципы"
        >
          <li class="flex gap-2">
            <CircleCheck
              aria-hidden="true"
              class="mt-0.5 text-[rgb(var(--color-accent))]"
              size={18}
            />
            <span>Без неподтверждённых обещаний</span>
          </li>
          <li class="flex gap-2">
            <CircleCheck
              aria-hidden="true"
              class="mt-0.5 text-[rgb(var(--color-accent))]"
              size={18}
            />
            <span>Понятная коммуникация</span>
          </li>
          <li class="flex gap-2">
            <CircleCheck
              aria-hidden="true"
              class="mt-0.5 text-[rgb(var(--color-accent))]"
              size={18}
            />
            <span>Акцент на контроле этапов</span>
          </li>
        </ul>
      </div>

      <div class="relative min-h-[430px] md:min-h-[500px] xl:min-h-[560px]">
        <div
          class="absolute inset-0 overflow-hidden rounded-[var(--radius-sm)] border border-white/10 bg-white/5 shadow-[var(--shadow-strong)]"
        >
          <ImagePlaceholder
            decorative
            ratio="16 / 13"
            className="h-full rounded-none border-0 bg-[linear-gradient(135deg,rgb(255_255_255_/_0.14),rgb(255_255_255_/_0.04)_45%,rgb(var(--color-accent)_/_0.13))]"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-[linear-gradient(90deg,rgb(17_19_21_/_0.24),transparent_45%)]"
          >
          </div>
        </div>

        <aside
          aria-labelledby="lead-request-title"
          class="absolute bottom-5 left-5 right-5 rounded-[var(--radius-sm)] border border-white/12 bg-[rgb(var(--color-surface-dark)_/_0.88)] p-6 text-white shadow-[var(--shadow-strong)] backdrop-blur-sm sm:left-auto sm:w-[360px] lg:right-6"
          id="lead-request"
        >
          <p
            class="text-sm font-bold uppercase tracking-[0.1em] text-[rgb(var(--color-accent))]"
          >
            Временная форма
          </p>
          <h2
            class="mt-2 text-xl font-black uppercase leading-tight"
            id="lead-request-title"
          >
            {site.hero.formTitle}
          </h2>
          <p class="mt-3 text-sm leading-6 text-white/68">
            {site.hero.formDescription}
          </p>
          <div class="mt-5 grid gap-3" aria-hidden="true">
            <div
              class="h-11 rounded-[var(--radius-sm)] border border-white/16 bg-white"
            >
            </div>
            <div
              class="h-11 rounded-[var(--radius-sm)] border border-white/16 bg-white"
            >
            </div>
            <div
              class="h-11 rounded-[var(--radius-sm)] bg-[rgb(var(--color-accent))]"
            >
            </div>
          </div>
        </aside>
      </div>
    </div>
  </Container>
</section>
