---
import { ArrowRight } from "@lucide/astro";
import { preparedAssets } from "../../data/assets";
import { finalCta } from "../../data/final-cta";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import ResponsiveImage from "../ui/ResponsiveImage.astro";
---

<section
  aria-labelledby="contact-title"
  class="final-cta border-b border-white/10 bg-[rgb(var(--color-surface-dark))] text-white"
  id="contact"
>
  <div aria-hidden="true" class="final-cta__media">
    <ResponsiveImage
      alt=""
      className="final-cta__picture"
      desktop={preparedAssets.cta.desktop}
      desktopSizes="100vw"
      mobile={preparedAssets.cta.mobile}
      mobileSizes="100vw"
    />
  </div>
  <Container>
    <div
      class="grid gap-8 py-[var(--section-space-sm)] lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center"
    >
      <div class="min-w-0">
        <div class="mb-5 flex items-center gap-4">
          <span
            aria-hidden="true"
            class="h-px w-12 bg-[rgb(var(--color-accent))]"></span>
          <p
            class="text-sm font-bold uppercase tracking-[0.12em] text-[rgb(var(--color-accent))]"
          >
            {finalCta.eyebrow}
          </p>
        </div>
        <h2
          class="max-w-4xl text-[clamp(2rem,3.8vw,4rem)] font-black uppercase leading-[1.02]"
          id="contact-title"
        >
          {finalCta.title}
        </h2>
        <p class="mt-5 max-w-3xl text-base leading-8 text-white/70 sm:text-lg">
          {finalCta.description}
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-white/52">
          {finalCta.secondaryText}
        </p>
      </div>

      <Button href={finalCta.primaryHref} className="w-full lg:w-auto">
        <span class="inline-flex items-center gap-2">
          {finalCta.primaryLabel}
          <ArrowRight aria-hidden="true" size={18} />
        </span>
      </Button>
    </div>
  </Container>
</section>

<style>
  .final-cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .final-cta__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .final-cta__picture,
  .final-cta__picture :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .final-cta__picture :global(img) {
    object-fit: cover;
    object-position: center;
  }
</style>
