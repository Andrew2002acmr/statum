---
import {
  CircleCheck,
  ClipboardList,
  MessageCircle,
  Ruler,
  Wrench,
} from "@lucide/astro";
import { processSteps } from "../../data/process";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const icons = {
  MessageCircle,
  Ruler,
  ClipboardList,
  Wrench,
  CircleCheck,
};
---

<section
  aria-labelledby="process-title"
  class="overflow-hidden bg-[rgb(var(--color-surface-dark))] text-white"
  id="process"
>
  <Container>
    <div class="py-[var(--section-space-lg)]">
      <SectionHeading
        eyebrow="Как проходит работа"
        title="Пять понятных шагов"
        description="Последовательность помогает заранее увидеть логику проекта и не смешивать обсуждение, подготовку и выполнение работ в один непрозрачный процесс."
        theme="dark"
        align="center"
        id="process-title"
      />

      <div
        class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-md)] border border-white/10 bg-white/10 md:grid-cols-2 xl:grid-cols-5"
      >
        {
          processSteps.map((step, index) => {
            const Icon = icons[step.icon];
            const number = String(index + 1).padStart(2, "0");
            const isLast = index === processSteps.length - 1;

            return (
              <article
                class={`relative grid min-h-[250px] content-start gap-5 bg-[rgb(var(--color-surface-dark))] p-6 ${isLast ? "md:col-span-2 xl:col-span-1" : ""}`}
                data-process-step
              >
                <div class="flex items-start justify-between gap-4">
                  <span class="text-5xl font-black leading-none text-[rgb(var(--color-accent))]">
                    {number}
                  </span>
                  <span class="grid h-12 w-12 place-items-center rounded-[var(--radius-sm)] border border-white/12 text-[rgb(var(--color-accent))]">
                    <Icon aria-hidden="true" size={24} stroke-width={1.9} />
                  </span>
                </div>

                <div>
                  <h3 class="text-xl font-black uppercase leading-tight text-white">
                    {step.title}
                  </h3>
                  <p class="mt-3 text-sm leading-6 text-white/68">
                    {step.text}
                  </p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </Container>
</section>
