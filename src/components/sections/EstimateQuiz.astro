---
import {
  estimateQuizContent,
  estimateQuizQuestions,
} from "../../data/estimate-quiz";
import Container from "../ui/Container.astro";
import ImagePlaceholder from "../ui/ImagePlaceholder.astro";
import QuizOption from "../ui/QuizOption.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section
  aria-labelledby="estimate-title"
  class="bg-[rgb(var(--color-surface-dark))] text-white"
  data-testid="estimate-section"
  id="estimate"
>
  <Container>
    <div class="py-[var(--section-space-lg)]">
      <div
        class="grid gap-10 lg:grid-cols-[minmax(0,0.86fr)_minmax(420px,0.72fr)] lg:items-center xl:gap-16"
      >
        <div class="min-w-0">
          <SectionHeading
            eyebrow={estimateQuizContent.eyebrow}
            title={estimateQuizContent.title}
            description={estimateQuizContent.description}
            theme="dark"
            id="estimate-title"
          />

          <div
            class="mt-8 overflow-hidden rounded-[var(--radius-md)] border border-white/10 bg-white/[0.04] p-3 shadow-[var(--shadow-strong)]"
          >
            <ImagePlaceholder
              label={estimateQuizContent.visualLabel}
              ratio="4 / 3"
              decorative
              className="border-white/10 bg-[linear-gradient(135deg,rgb(255_255_255_/_0.16),rgb(204_141_28_/_0.08))]"
            />
          </div>
        </div>

        <form
          aria-describedby="estimate-progress-text"
          class="min-w-0 rounded-[var(--radius-md)] border border-white/10 bg-[#202020] p-5 shadow-[var(--shadow-strong)] sm:p-7"
          data-estimate-quiz
          data-testid="estimate-quiz"
        >
          <div class="mb-6">
            <p
              class="text-sm font-bold uppercase tracking-[0.12em] text-[rgb(var(--color-accent))]"
            >
              Шаги оценки
            </p>
            <div class="mt-4 flex items-center gap-4">
              <progress
                aria-label="Прогресс квиза"
                class="h-2 flex-1 overflow-hidden rounded-full accent-[rgb(var(--color-accent))]"
                data-quiz-progress
                max={estimateQuizQuestions.length}
                value="1"></progress>
              <p
                class="shrink-0 text-sm font-semibold text-white/72"
                data-quiz-progress-text
                id="estimate-progress-text"
              >
                Шаг 1 из {estimateQuizQuestions.length}
              </p>
            </div>
          </div>

          <div class="space-y-6" data-quiz-steps>
            {
              estimateQuizQuestions.map((question, index) => (
                <fieldset
                  class="min-w-0"
                  data-quiz-step
                  data-quiz-step-index={index}
                  data-question-id={question.id}
                >
                  <legend
                    class="text-2xl font-black uppercase leading-tight text-white sm:text-3xl"
                    data-quiz-step-title
                    tabindex="-1"
                  >
                    {question.title}
                  </legend>
                  <p class="mt-3 max-w-xl text-sm leading-6 text-white/64 sm:text-base">
                    {question.description}
                  </p>
                  <div class="mt-5 grid gap-3">
                    {question.options.map((option) => (
                      <QuizOption
                        questionId={question.id}
                        required={question.required}
                        value={option.value}
                        label={option.label}
                        description={option.description}
                      />
                    ))}
                  </div>
                </fieldset>
              ))
            }
          </div>

          <div
            class="rounded-[var(--radius-sm)] border border-[rgb(var(--color-accent))]/35 bg-[rgb(var(--color-accent))]/10 p-5"
            data-quiz-final
            hidden
          >
            <p class="text-2xl font-black uppercase leading-tight text-white">
              {estimateQuizContent.finalTitle}
            </p>
            <p class="mt-3 text-sm leading-6 text-white/68 sm:text-base">
              {estimateQuizContent.finalMessage}
            </p>
            <a
              class="mt-5 inline-flex min-h-11 items-center justify-center rounded-[var(--radius-sm)] bg-[rgb(var(--color-accent))] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[rgb(var(--color-accent-strong))]"
              href="#lead-request"
            >
              {estimateQuizContent.finalCtaLabel}
            </a>
          </div>

          <!-- The lead form reads this value and sends it only after explicit contact-form submit. -->
          <input
            data-quiz-summary
            name="estimateQuizAnswers"
            type="hidden"
            value=""
          />

          <noscript>
            <p
              class="mt-6 rounded-[var(--radius-sm)] border border-white/12 bg-white/[0.04] p-4 text-sm leading-6 text-white/70"
            >
              Пошаговый режим работает с JavaScript. Без него можно просмотреть
              все вопросы, но ответы пока не отправляются.
            </p>
          </noscript>

          <div
            class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
            data-quiz-controls
            hidden
          >
            <button
              class="inline-flex min-h-11 items-center justify-center rounded-[var(--radius-sm)] border border-white/18 px-5 py-3 text-sm font-semibold text-white transition hover:border-[rgb(var(--color-accent))] hover:text-[rgb(var(--color-accent))] disabled:cursor-not-allowed disabled:opacity-45"
              data-quiz-prev
              type="button"
            >
              Назад
            </button>
            <button
              class="inline-flex min-h-11 items-center justify-center rounded-[var(--radius-sm)] bg-[rgb(var(--color-accent))] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[rgb(var(--color-accent-strong))] disabled:cursor-not-allowed disabled:bg-white/16 disabled:text-white/45 sm:min-w-40"
              data-quiz-next
              disabled
              type="button"
            >
              Далее
            </button>
          </div>
        </form>
      </div>
    </div>
  </Container>
</section>

<script src="../../scripts/estimate-quiz.ts"></script>
