---
import { CircleCheck } from "@lucide/astro";
import { about } from "../../data/about";
import { preparedAssets } from "../../data/assets";
import Container from "../ui/Container.astro";
import ResponsiveImage from "../ui/ResponsiveImage.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section
  aria-labelledby="about-title"
  class="border-b border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg))]"
  id="about"
>
  <Container>
    <div
      class="grid gap-10 py-[var(--section-space-lg)] lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1fr)] lg:items-center lg:gap-16"
    >
      <div>
        <SectionHeading
          eyebrow={about.eyebrow}
          title={about.title}
          description={about.description}
          id="about-title"
        />

        <div class="mt-8 grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          {
            about.points.map((point) => (
              <article class="flex gap-4 border-l-2 border-[rgb(var(--color-accent))] bg-[rgb(var(--color-surface))] p-5 shadow-[var(--shadow-soft)]">
                <CircleCheck
                  aria-hidden="true"
                  class="mt-1 shrink-0 text-[rgb(var(--color-accent-strong))]"
                  size={22}
                  stroke-width={1.9}
                />
                <div>
                  <h3 class="text-lg font-extrabold leading-snug text-[rgb(var(--color-text))]">
                    {point.title}
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-[rgb(var(--color-muted))]">
                    {point.text}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="lg:order-first">
        <div class="relative">
          <ResponsiveImage
            alt="Интерьер кухни-гостиной с полноценной системой хранения"
            className="about__image"
            desktop={preparedAssets.about}
            desktopSizes="(min-width: 1024px) calc((min(100vw - 5rem, 1500px) - 4rem) / 2), calc(100vw - 2rem)"
          />
          <span
            class="absolute bottom-4 left-4 rounded-[var(--radius-sm)] border border-white/20 bg-black/65 px-3 py-2 text-[0.68rem] font-bold uppercase tracking-[0.08em] text-white/80 backdrop-blur-sm"
          >
            Интерьерная визуализация
          </span>
          <div
            aria-hidden="true"
            class="absolute -bottom-5 right-5 h-20 w-1 bg-[rgb(var(--color-accent))] sm:right-8"
          >
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .about__image {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: rgb(var(--color-surface-dark));
    box-shadow: var(--shadow-soft);
  }

  .about__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
  }
</style>
