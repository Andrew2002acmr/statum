---
import { ArrowRight } from "@lucide/astro";
import { projects } from "../../data/projects";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import ProjectCard from "../ui/ProjectCard.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section
  aria-labelledby="projects-title"
  class="border-b border-[rgb(var(--color-border))] bg-[rgb(var(--color-bg))]"
  id="projects"
>
  <Container>
    <div class="py-[var(--section-space-lg)]">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.78fr)_auto] lg:items-end">
        <SectionHeading
          eyebrow="Работы"
          title="Реальные детали выполненных работ"
          description="Фотографии показывают отделку и узлы без сгенерированных интерьеров. Названия описывают видимый фрагмент; сведения об объектах уточняются отдельно."
          id="projects-title"
        />
        <Button
          href="#lead-request"
          variant="secondary"
          className="w-full sm:w-fit lg:justify-self-end"
        >
          <span class="inline-flex items-center gap-2">
            {`Обсудить похожую задачу`}
            <ArrowRight aria-hidden="true" size={18} />
          </span>
        </Button>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-5">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.title}
              category={project.category}
              image={project.image}
              alt={project.alt}
            />
          ))
        }
      </div>
    </div>
  </Container>
</section>
