---
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Hero.astro";
import TrustFeatures from "../components/sections/TrustFeatures.astro";
import About from "../components/sections/About.astro";
import Process from "../components/sections/Process.astro";
import Services from "../components/sections/Services.astro";
import Benefits from "../components/sections/Benefits.astro";
import Projects from "../components/sections/Projects.astro";
import Statistics from "../components/sections/Statistics.astro";
import EstimateQuiz from "../components/sections/EstimateQuiz.astro";
import Reviews from "../components/sections/Reviews.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import Footer from "../components/layout/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="СТАТУМ — ремонтные работы под контролем"
  description="Лендинг для ремонтных работ: понятный подход, услуги, примеры проектов и будущая заявка на расчёт."
>
  <div id="top"></div>
  <Header />
  <main>
    <Hero />
    <TrustFeatures />
    <About />
    <Process />
    <Services />
    <Benefits />
    <Projects />
    <Statistics />
    <EstimateQuiz />
    <Reviews />
    <FinalCta />
  </main>
  <Footer />
</BaseLayout>
