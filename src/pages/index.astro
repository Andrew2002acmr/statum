---
import Container from "../components/ui/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout title="Statum technical scaffold">
  <main class="min-h-screen py-[var(--section-space-md)]">
    <Container>
      <section class="grid min-h-[60vh] place-items-center text-center">
        <div class="max-w-2xl">
          <p
            class="mb-3 text-sm font-semibold uppercase tracking-[0.08em] text-[rgb(var(--color-accent-strong))]"
          >
            Stage 0
          </p>
          <h1
            class="text-[var(--font-size-3xl)] font-bold leading-tight text-[rgb(var(--color-text))]"
          >
            Statum Astro scaffold is running
          </h1>
          <p class="mt-5 text-lg leading-8 text-[rgb(var(--color-muted))]">
            Техническая основа проекта готовится отдельно от реализации секций
            лендинга.
          </p>
        </div>
      </section>
    </Container>
  </main>
</BaseLayout>
