---
import Container from "../components/ui/Container.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Hero.astro";
import TrustFeatures from "../components/sections/TrustFeatures.astro";
import About from "../components/sections/About.astro";
import Process from "../components/sections/Process.astro";
import Services from "../components/sections/Services.astro";
import Benefits from "../components/sections/Benefits.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="СТАТУМ — ремонтные работы под контролем"
  description="Временная верхняя часть лендинга для ремонтных работ: header, hero и ключевые преимущества."
>
  <div id="top"></div>
  <Header />
  <main>
    <Hero />
    <TrustFeatures />
    <About />
    <Process />
    <Services />
    <Benefits />
    <Container>
      <section
        aria-label="Будущие секции лендинга"
        class="grid gap-4 py-[var(--section-space-sm)] text-sm text-[rgb(var(--color-muted))]"
      >
        <div id="projects"></div>
      </section>
    </Container>
  </main>
</BaseLayout>
